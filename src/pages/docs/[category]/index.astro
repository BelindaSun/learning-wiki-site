---
import Base from "../../../layouts/Base.astro";
import { CATEGORIES, getDocsInCategory } from "../../../lib/content";

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({
    params: { category: c.key },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const docs = getDocsInCategory(category.key);
---

<Base title={category.label}>
  <div class="container">
    <p class="breadcrumb"><a href="/">首页</a> / {category.label}</p>
    <h1 class="article-title">{category.icon} {category.label}</h1>
    <p class="article-updated">{category.description}</p>
  </div>
  <ul class="plain-list">
    {
      docs.map((d) => (
        <li>
          <a href={`/${d.slug}`} style="font-size:1.05rem">
            {d.title}
          </a>
          {d.highlight && (
            <p style="color:var(--text-muted); font-size:0.9rem; margin:6px 0 0;">
              {d.highlight.length > 140 ? d.highlight.slice(0, 140) + "…" : d.highlight}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</Base>
