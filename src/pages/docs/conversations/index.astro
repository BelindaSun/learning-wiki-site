---
import Base from "../../../layouts/Base.astro";
import { getAllDocs } from "../../../lib/content";

const docs = getAllDocs()
  .filter((d) => d.dir === "docs/conversations")
  .sort((a, b) => a.title.localeCompare(b.title, "zh"));
---

<Base title="完整对话记录">
  <div class="container">
    <p class="breadcrumb"><a href="/">首页</a> / 完整对话记录</p>
    <h1 class="article-title">📖 完整学习对话记录</h1>
    <p class="article-updated">每篇正式指南背后，跟 Claude 完整对话的原始记录</p>
  </div>
  <ul class="plain-list">
    {
      docs.map((d) => (
        <li>
          <a href={`/${d.slug}`} style="font-size:1.05rem">
            {d.title}
          </a>
        </li>
      ))
    }
  </ul>
</Base>
