---
import Base from "../layouts/Base.astro";
import { CATEGORIES, getChangelogLatest } from "../lib/content";

const latest = getChangelogLatest();

const extraCards = [
  { key: "mental-models", label: "心智模型", icon: "🧠", description: "看世界方式的变迁轨迹", href: "/mental-models" },
  { key: "concepts", label: "全部概念索引", icon: "📖", description: "按字母排序的所有主题", href: "/index-all-concepts" },
];

const readingPath = [
  { n: 1, text: "如果你对 Agent 感兴趣，从", link: "Agent 架构", href: "/docs/ai-core/agent-architecture" },
  { n: 2, text: "如果你想实战，从", link: "Skill 设计", href: "/docs/ai-application/skills-business-landscape" },
  { n: 3, text: "如果你想了解影响，从", link: "职业冲击", href: "/docs/career-impact/model-to-system-war" },
];
---

<Base title="首页">
  <div class="hero">
    <div class="eyebrow">个人学习知识库</div>
    <h1>AI & Beyond</h1>
    <p>
      一个持续增长的个人学习知识库。主要记录 AI 学习，兼收其他感兴趣的话题。每天在这里添加新的学习内容——来自对话、论文、实验、思考。
    </p>
    <blockquote>"The best way to learn is to teach. The best way to remember is to write."</blockquote>
  </div>

  <div id="structure" class="section-label">结构</div>
  <div class="card-grid">
    {
      CATEGORIES.map((c) => (
        <a class="card" href={`/docs/${c.key}/`}>
          <div class="card-icon">{c.icon}</div>
          <h3>{c.label}</h3>
          <p>{c.description}</p>
        </a>
      ))
    }
    {
      extraCards.map((c) => (
        <a class="card accent" href={c.href}>
          <div class="card-icon">{c.icon}</div>
          <h3>{c.label}</h3>
          <p>{c.description}</p>
        </a>
      ))
    }
  </div>

  <div id="reading" class="reading-path">
    <div class="section-label" style="margin-top:0">建议阅读方式</div>
    <ol>
      {
        readingPath.map((r) => (
          <li>
            <span class="num">{r.n}</span>
            <span>
              {r.text} <a href={r.href}>{r.link}</a> 开始
            </span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="updates-table">
    <div class="section-label" style="margin-top:0">最新更新</div>
    {
      latest && (
        <div class="update-row">
          <span>{latest.date}</span>
          <span>{latest.topic}</span>
          <a class="badge" href="/CHANGELOG">
            查看完整日志 →
          </a>
        </div>
      )
    }
  </div>
</Base>
