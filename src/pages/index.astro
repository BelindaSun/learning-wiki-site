---
import Base from "../layouts/Base.astro";
import { CATEGORIES, getChangelogLatest } from "../lib/content";

const latest = getChangelogLatest();

const byKey = (key: string) => CATEGORIES.find((c) => c.key === key)!;
const computingFoundations = byKey("computing-foundations");
const aiCore = byKey("ai-core");
const aiPractice = byKey("ai-application");
const aiResearch = byKey("ai-research");
const industryImpact = byKey("career-impact");

// 依赖排序的领土堆叠：前沿在上、窄；地基在下、宽——倒三角形，越宽越该先点。
// 跟导航顺序（CATEGORIES，地基排第一）是同一份数据的两种表示，故意不统一
// ——见 CLAUDE.md「导航顺序 vs 依赖可视化」。
const territoryStack = [
  { cards: [industryImpact], width: 420 },
  { cards: [aiResearch, aiPractice], width: 560 },
  { cards: [aiCore], width: 640 },
  { cards: [computingFoundations], foundation: true, width: 720 },
];

const doors = [
  {
    icon: "🗺️",
    label: "Learn",
    desc: "我要系统学 → Start Here，30 分钟建立最小地图",
    href: "/start-here",
    sublinks: [{ label: "Start Here", href: "/start-here" }],
  },
  {
    icon: "🔤",
    label: "Look Up",
    desc: "我卡在一个词上 → 查一下",
    href: "/glossary",
    sublinks: [
      { label: "术语表", href: "/glossary" },
      { label: "全部概念索引", href: "/index-all-concepts" },
    ],
  },
  {
    icon: "🧠",
    label: "Explore",
    desc: "我想看想法怎么连起来的 → 心智模型变迁史",
    href: "/mental-models",
    sublinks: [{ label: "Mental Models", href: "/mental-models" }],
  },
];
---

<Base title="首页">
  <div class="hero">
    <div class="eyebrow">个人学习知识库</div>
    <h1>AI & Beyond</h1>
    <p>
      一个持续增长的个人学习知识库。主要记录 AI 学习，兼收其他感兴趣的话题。每天在这里添加新的学习内容——来自对话、论文、实验、思考。
    </p>
    <blockquote>"The best way to learn is to teach. The best way to remember is to write."</blockquote>
  </div>

  <div class="section-label">怎么进来</div>
  <div class="doors-grid">
    {
      doors.map((d) => (
        <div class="door-card">
          <a class="door-card-link" href={d.href}>
            <div class="card-icon">{d.icon}</div>
            <h3>{d.label}</h3>
            <p>{d.desc}</p>
          </a>
          {d.sublinks.length > 1 && (
            <div class="door-sublinks">
              {d.sublinks.map((s) => (
                <a href={s.href}>{s.label} →</a>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>

  <div id="structure" class="section-label">结构（知识领土，按依赖排序——地基最宽、在下，先点它）</div>
  <div class="territory-stack">
    {
      territoryStack.map((row) => (
        <div
          class={`territory-row ${row.cards.length === 1 ? "single" : ""}`}
          style={`max-width:${row.width}px`}
        >
          {row.cards.map((c) => (
            <a class={`territory-card ${row.foundation ? "foundation" : ""}`} href={`/docs/${c.key}/`}>
              <div class="card-icon">{c.icon}</div>
              <div>
                <h3>{c.label}</h3>
                <p>{c.description}</p>
              </div>
            </a>
          ))}
        </div>
      ))
    }
  </div>
  <p class="territory-stack-caption">
    Computing Foundations 是地基（AI Core 依赖它）——最宽的那一条，导航栏里它也排第一项。
  </p>

  <div class="updates-table">
    <div class="section-label" style="margin-top:0">最新更新</div>
    {
      latest && (
        <div class="update-row">
          <span>{latest.date}</span>
          <span>{latest.topic}</span>
          <a class="badge" href="/CHANGELOG">
            查看完整日志 →
          </a>
        </div>
      )
    }
  </div>
</Base>
