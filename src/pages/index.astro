---
import Base from "../layouts/Base.astro";
import { CATEGORIES, getChangelogLatest } from "../lib/content";

const latest = getChangelogLatest();

const extraCards = [
  { key: "mental-models", label: "心智模型", icon: "🧠", description: "我对 AI 的理解是怎么变化的", href: "/mental-models" },
  { key: "concepts", label: "全部概念索引", icon: "📖", description: "按字母/主题找到所有知识节点", href: "/index-all-concepts" },
  { key: "glossary", label: "术语表", icon: "🔤", description: "不懂一个词，10 秒钟看懂", href: "/glossary" },
];

const entryChoices = [
  { icon: "🗺️", label: "我完全没背景", desc: "New to AI? 从 Start Here 开始，60-90 分钟建立最小地图", href: "/start-here" },
  { icon: "🧭", label: "我已经懂基础了", desc: "直接去下面的分类里探索", href: "#structure" },
  { icon: "🧠", label: "我想看想法怎么连起来的", desc: "看心智模型变迁史", href: "/mental-models" },
  { icon: "🔤", label: "我卡在一个词上", desc: "去术语表一句话查一下", href: "/glossary" },
];
---

<Base title="首页">
  <div class="hero">
    <div class="eyebrow">个人学习知识库</div>
    <h1>AI & Beyond</h1>
    <p>
      一个持续增长的个人学习知识库。主要记录 AI 学习，兼收其他感兴趣的话题。每天在这里添加新的学习内容——来自对话、论文、实验、思考。
    </p>
    <blockquote>"The best way to learn is to teach. The best way to remember is to write."</blockquote>
    <p style="margin-top: 28px;">
      <a href="/start-here" class="cta-button">🗺️ 第一次来？从 Start Here 开始 →</a>
    </p>
  </div>

  <div class="section-label">怎么开始</div>
  <div class="card-grid">
    {
      entryChoices.map((c) => (
        <a class="card" href={c.href}>
          <div class="card-icon">{c.icon}</div>
          <h3>{c.label}</h3>
          <p>{c.desc}</p>
        </a>
      ))
    }
  </div>

  <div id="structure" class="section-label">结构（按主题探索）</div>
  <div class="card-grid">
    {
      CATEGORIES.map((c) => (
        <a class="card" href={`/docs/${c.key}/`}>
          <div class="card-icon">{c.icon}</div>
          <h3>{c.label}</h3>
          <p>{c.description}</p>
        </a>
      ))
    }
    {
      extraCards.map((c) => (
        <a class="card accent" href={c.href}>
          <div class="card-icon">{c.icon}</div>
          <h3>{c.label}</h3>
          <p>{c.description}</p>
        </a>
      ))
    }
  </div>

  <div class="updates-table">
    <div class="section-label" style="margin-top:0">最新更新</div>
    {
      latest && (
        <div class="update-row">
          <span>{latest.date}</span>
          <span>{latest.topic}</span>
          <a class="badge" href="/CHANGELOG">
            查看完整日志 →
          </a>
        </div>
      )
    }
  </div>
</Base>
