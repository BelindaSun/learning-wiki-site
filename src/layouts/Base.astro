---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

const pageUrl = `https://learning-wiki-site.vercel.app${Astro.url.pathname}`;
const issueTitle = `反馈: ${title}`;
const issueBody = `页面: ${pageUrl}\n\n请描述你发现的问题或建议：\n`;
const feedbackUrl = `https://github.com/BelindaSun/learning-wiki/issues/new?title=${encodeURIComponent(
  issueTitle,
)}&body=${encodeURIComponent(issueBody)}`;
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Belinda's Learning Wiki</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-badge">SUN</span>
        <span class="brand-name">Belinda Sun</span>
      </a>
      <nav>
        <a href="/docs/computing-foundations/">Computing Foundations</a>
        <a href="/start-here">Learn</a>
        <a href="/glossary">Look Up</a>
        <a href="/mental-models">Explore</a>
        <a class="muted" href="/CHANGELOG">更新日志</a>
        <a class="muted" href="https://github.com/BelindaSun/learning-wiki" target="_blank" rel="noopener">GitHub</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <a class="feedback-link" href={feedbackUrl} target="_blank" rel="noopener">反馈 / Report an issue</a>
      <span>learning-wiki is maintained by BelindaSun · Deployed with Astro + Vercel</span>
    </footer>
    <script>
      // "← 返回上一页" links (data-back): go back in history if we got here
      // from within the site, otherwise fall back to the homepage.
      document.querySelectorAll("[data-back]").forEach((el) => {
        el.addEventListener("click", (e) => {
          e.preventDefault();
          if (document.referrer.startsWith(location.origin) && history.length > 1) {
            history.back();
          } else {
            location.href = "/";
          }
        });
      });
    </script>
  </body>
</html>
