---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Belinda's Learning Wiki</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Belinda's Learning Wiki</a>
      <nav>
        <a href="/start-here">Start Here</a>
        <a href="/glossary">术语表</a>
        <a href="/#structure">结构</a>
        <a href="/CHANGELOG">更新日志</a>
        <a href="https://github.com/BelindaSun/learning-wiki" target="_blank" rel="noopener">GitHub</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>learning-wiki is maintained by BelindaSun · Deployed with Astro + Vercel</p>
    </footer>
  </body>
</html>
